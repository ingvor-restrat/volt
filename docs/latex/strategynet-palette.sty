\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{strategynet-palette}
  [2026/07/24 StrategyNet.ai publication palette]

\RequirePackage[table]{xcolor}

% A strictly achromatic publication palette.  The legacy semantic token names
% remain stable so existing reports inherit the monochrome identity without
% source-level rewrites.
\definecolor{SNMidnight}{HTML}{171717}
\definecolor{SNInk}{HTML}{292929}
\definecolor{SNSlate}{HTML}{505050}
\definecolor{SNMuted}{HTML}{737373}
\definecolor{SNPaper}{HTML}{FAFAFA}
\definecolor{SNMist}{HTML}{F0F0F0}
\definecolor{SNLine}{HTML}{CACACA}
\definecolor{SNSignal}{HTML}{484848}
\definecolor{SNSignalDark}{HTML}{2C2C2C}
\definecolor{SNViolet}{HTML}{3E3E3E}
\definecolor{SNCoral}{HTML}{5C5C5C}
\definecolor{SNGold}{HTML}{696969}
\definecolor{SNSuccess}{HTML}{535353}
\definecolor{SNDanger}{HTML}{363636}

\colorlet{SNLink}{SNSignalDark}
\colorlet{SNCodeBackground}{SNMist}
\colorlet{SNTableStripe}{SNMist}

\newcommand{\SNwordmark}{%
  \textsf{\bfseries\textcolor{SNMidnight}{strategynet.ai}}%
}

\newcommand{\SNwordmarkondark}{%
  \textsf{\bfseries\textcolor{white}{strategynet.ai}}%
}

\endinput
